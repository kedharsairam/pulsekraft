<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Two permissions, and the reason each exists.

      INTERNET is the one permission every other Kraft app does not have,
      and this app cannot exist without it: measuring a connection means
      sending bytes over it. The About screen says so in those words
      rather than burying the difference.

      ACCESS_NETWORK_STATE is for reading whether the current network is
      metered, so the app can warn before spending somebody's data
      allowance and can name the transport it is running over.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      No camera, no location, no microphone, no storage, no background
      work, no notifications.

      A speed test needs a socket and the truth about the network it is
      on. Everything above that list would be collected on principle
      rather than for a feature, and the whole pitch of this app is that
      it does not do that.
    -->

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PulseKraft">

        <!--
          Portrait, deliberately.

          This is a one-screen instrument held in one hand for about
          forty seconds, and every layout in it is a single column built
          around a figure sized to a thumb's width. Rotated, the content
          is roughly 500dp tall in a 390dp viewport, and the honest
          options were to compress every dimension or to let the middle
          of the screen fall off the bottom — which is what it did, and
          it dropped the instruction, the cost, the list of measurements
          and the about link with no way to scroll to them.

          A landscape layout would be a second design rather than an
          adaptation of this one, and it is not wanted. Locking is the
          honest answer, and the reason is recorded here rather than
          discovered by a person rotating their phone.

          Large screens ignore this attribute, which is correct: there
          the window is wide enough for the column to have its margins
          back.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.PulseKraft">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
