# Gradle
.gradle/
build/
local.properties

# Android build output
*.apk
*.aab
*.ap_
*.dex
release/

# IDE
.idea/
*.iml
.kotlin/

# Signing material never belongs in git. This project has no release
# keystore on purpose: no store distribution, GitHub releases only, and
# the published APK is debug-signed so what a user installs is a build
# the author also built.
*.jks
*.keystore
keystore.properties

# OS
.DS_Store
Thumbs.db

# Artefacts of adb sweeps: a uiautomator dump and a screenshot. These
# look enough like project files to survive a review, and neither
# belongs in a public repository.
#
# Written as a general rule rather than a list of names, because the list
# only ever grows: an ignore file that names /u.xml and /d.xml does not
# stop the next /p.xml, it just records that somebody forgot one. Every
# real asset in an Android project lives under app/src/main/res or in a
# named asset directory, so nothing at the repository root is ever
# legitimate.
/*.xml
/*.png
